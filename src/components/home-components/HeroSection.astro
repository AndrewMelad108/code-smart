---
import { ArrowUpRight, ArrowUpLeft, Rocket } from "@lucide/astro";
import { SIGNUP_URL } from "@/constants";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)("hero");
const Arrow = lang === "ar" ? ArrowUpLeft : ArrowUpRight;
---

<section
  id="home"
  class="relative min-h-[811px] overflow-hidden bg-hero pt-9 pb-16 md:pt-[60px] md:pb-15"
  aria-labelledby="hero-title"
>
  <img
    class="pointer-events-none absolute top-12 z-10 hidden h-[110px] w-20 object-contain xl:block ltr:left-[60px] ltr:2xl:left-[calc((100vw-1320px)/2)] rtl:right-[60px] rtl:2xl:right-[calc((100vw-1320px)/2)]"
    src="/assistant-robot.png"
    alt="assistant robot"
    aria-hidden="true"
  />

  <div
    class="relative z-10 mx-auto grid w-[calc(100%-40px)] max-w-[1320px] grid-cols-1 items-center gap-8 text-center lg:grid-cols-[563px_minmax(0,654px)] lg:justify-between lg:gap-10 lg:text-start"
  >
    <div class="mx-auto max-w-[563px] lg:mx-0">
      <h1
        id="hero-title"
        class="text-[34px] leading-[1.35] font-black text-black sm:text-[48px] lg:text-[60px] lg:leading-[1.12] lg:font-bold [:lang(en)_&]:leading-[1.18] [:lang(en)_&]:tracking-tight"
      >
        {t.title}<br />{
          lang === "ar" ? (
            <span class="lg:whitespace-nowrap">
              <span class="text-green">ونصنع</span>{" "}
              <span class="text-brand">جيل المستقبل</span>
            </span>
          ) : (
            <span class="text-brand">{t.highlight}</span>
          )
        }
      </h1>
      <p
        class="mx-auto mt-5 max-w-165 text-[13px] leading-[2.1] text-muted md:text-base lg:w-[388px] lg:max-w-[388px] lg:text-[18px] lg:leading-9 ltr:lg:mr-auto ltr:lg:ml-0 rtl:lg:mr-0 rtl:lg:ml-auto"
      >
        {t.description}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:gap-10">
        <a
          class="inline-flex h-[52px] w-[188px] max-w-full items-center justify-center gap-2.5 rounded-xl bg-brand-gradient px-6 py-3 text-xs font-extrabold text-white shadow-button transition-transform hover:-translate-y-0.5"
          href={SIGNUP_URL ?? "#future"}
          >{t.primary}<Arrow size={17} aria-hidden="true" /></a
        >
        <a
          class="inline-flex h-14 w-[158px] max-w-full items-center justify-center rounded-xl border-2 border-[#3b5bdb] bg-white px-5 py-3 text-xs font-extrabold text-[#1c2d5a] transition-transform hover:-translate-y-0.5"
          href="#academy">{t.secondary}</a
        >
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[654px] md:max-w-[654px]">
      <img
        class="relative z-10 w-full object-contain"
        src="/hero-student.jpg"
        width="1448"
        height="1086"
        alt={t.imageAlt}
        fetchpriority="high"
      />
    </div>
  </div>

  <div
    class="relative z-20 mx-auto mt-5 grid min-h-[180px] w-[calc(100%-40px)] max-w-[1320px] grid-cols-1 items-center gap-8 rounded-3xl border border-[#e4e2fa] bg-white/95 px-5 py-5 shadow-card md:grid-cols-[280px_1fr] md:px-10 md:py-6"
  >
    <div class="flex items-center justify-center gap-3 md:justify-start">
      <span
        class="flex size-12 items-center justify-center rounded-[16px] bg-brand-soft text-brand"
        ><Rocket size={22} aria-hidden="true" /></span
      >
      <div>
        <b class="block text-xl font-black text-ink">{t.experience}</b><strong
          class="mt-0.5 block text-2xl font-black text-green"
          >{t.experienceHighlight}</strong
        >
      </div>
    </div>
    <div class="relative hidden sm:block">
      <span
        class="absolute inset-x-[5%] top-[32%] z-0 h-1 rounded-full bg-[linear-gradient(90deg,#05df72_0%,#a3b3ff_50%,#e5e7eb_100%)]"
        aria-hidden="true"></span>
      <img
        class="relative z-10 w-full object-contain"
        src="/progress-steps.png"
        width="1504"
        height="210"
        alt=""
        aria-hidden="true"
      />
    </div>
    <ol
      class="relative m-0 grid list-none grid-cols-2 gap-x-2 gap-y-5 p-0 sm:hidden"
    >
      {
        t.stages.map((stage, index) => (
          <li class="relative z-10 text-center">
            <span
              class:list={[
                "mx-auto mb-2 flex size-9 items-center justify-center rounded-full border-[5px] border-white text-[10px] text-white ring-1 ring-[#e2e0fb]",
                index === t.stages.length - 1 ? "bg-green" : "bg-brand",
              ]}
            >
              {index + 1}
            </span>
            <>
              <b class="block text-[11px]">{stage.title}</b>
              <small class="mt-0.5 block text-[8px] text-[#9298af]">
                {stage.note}
              </small>
            </>
          </li>
        ))
      }
    </ol>
  </div>
</section>
