---
import { ArrowUpRight, ArrowUpLeft } from "@lucide/astro";
import { SIGNUP_URL } from "@/constants";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)("hero");
const Arrow = lang === "ar" ? ArrowUpLeft : ArrowUpRight;
---

<section
  id="home"
  class="relative overflow-hidden bg-hero pt-9 pb-16 md:pt-15 md:pb-15"
  aria-labelledby="hero-title"
>
  <div
    class="hero-layout relative z-10 grid grid-cols-1 items-center gap-8 text-center lg:grid-cols-[563px_minmax(0,654px)] lg:justify-between lg:gap-10 lg:ps-15 lg:text-start"
  >
    <div class="hero-copy order-2 mx-auto max-w-[563px] lg:order-1 lg:mx-0">
      <img
        src="/assistant-robot.png"
        alt="assistant robot"
        aria-hidden="true"
        class="mb-5 hidden h-27.5 w-20 lg:block"
      />
      <h1
        id="hero-title"
        class="pb-8 text-[36px] leading-[1.35] font-black text-black sm:text-[60px] lg:pb-15 lg:leading-[1.12] lg:font-bold [:lang(en)_&]:leading-[1.18] [:lang(en)_&]:tracking-tight"
      >
        {t.title}<br />{
          lang === "ar" ? (
            <span class="whitespace-nowrap">
              <span class="text-green">
                <span class="text-black">و</span>نصنع{" "}
              </span>
              <span class="text-brand">جيل المستقبل</span>
            </span>
          ) : (
            <span class="text-brand">{t.highlight}</span>
          )
        }
      </h1>
      <p
        class="mx-auto mt-5 max-w-165 text-[13px] leading-[2.1] text-muted md:text-base lg:w-[388px] lg:max-w-[388px] lg:text-[18px] lg:leading-9 ltr:lg:mr-auto ltr:lg:ml-0 rtl:lg:mr-0 rtl:lg:ml-auto"
      >
        {t.description}
      </p>
      <div
        class="hero-actions mt-8 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start lg:gap-10"
      >
        <a
          class="inline-flex h-[52px] w-[188px] max-w-full items-center justify-center gap-2.5 rounded-xl bg-brand-gradient px-6 py-3 text-xs font-extrabold text-white shadow-button transition-transform hover:-translate-y-0.5"
          href={SIGNUP_URL ?? "#future"}
          >{t.primary}<Arrow size={17} aria-hidden="true" /></a
        >
        <a
          class="inline-flex h-14 w-[158px] max-w-full items-center justify-center rounded-xl border-2 border-[#3b5bdb] bg-white px-5 py-3 text-xs font-extrabold text-[#1c2d5a] transition-transform hover:-translate-y-0.5"
          href="#academy">{t.secondary}</a
        >
      </div>
    </div>

    <div
      class="hero-image relative order-1 mx-auto w-full max-w-[654px] md:max-w-[654px] lg:order-2"
    >
      <img
        class="relative z-10 w-full object-contain"
        src="/hero-student.jpg"
        width="1448"
        height="1086"
        alt={t.imageAlt}
        fetchpriority="high"
      />
    </div>
  </div>

  <div
    class="hero-progress relative z-20 mx-auto mt-5 grid w-[calc(100%-20px)] grid-cols-1 items-center rounded-3xl border border-[#e4e2fa] bg-white/95 px-5 py-5 shadow-card md:px-10 md:py-6 lg:w-[calc(100%-60px)] lg:grid-cols-[364px_1fr]"
  >
    <div class="progress-heading flex justify-center lg:justify-start">
      <div>
        <b class="block text-[40px] font-black text-ink">{t.experience}</b
        ><strong class="mt-0.5 block text-[32px] font-black text-green"
          >{t.experienceHighlight}</strong
        >
      </div>
      <img
        class="h-25.25 w-25.25 object-contain"
        src="/why-code-smart-mark.png"
        alt="why-code-smart-mark"
        aria-hidden="true"
      />
    </div>

    <div class="progress-image relative hidden sm:block">
      <span
        class="absolute inset-x-[5%] top-[32%] z-0 h-1 rounded-full bg-[linear-gradient(90deg,#05df72_0%,#a3b3ff_50%,#e5e7eb_100%)]"
        aria-hidden="true"></span>
      <img
        class="relative z-10 w-full object-contain"
        src="/progress-steps.png"
        width="1504"
        height="210"
        alt=""
        aria-hidden="true"
      />
    </div>

    <ol
      class="progress-stages relative m-0 grid list-none grid-cols-2 gap-x-2 gap-y-5 p-0 sm:hidden"
    >
      {
        t.stages.map((stage, index) => (
          <li class="relative z-10 text-center">
            <span
              class:list={[
                "mx-auto mb-2 flex size-9 items-center justify-center rounded-full border-[5px] border-white text-[10px] text-white ring-1 ring-[#e2e0fb]",
                index === t.stages.length - 1 ? "bg-green" : "bg-brand",
              ]}
            >
              {index + 1}
            </span>
            <>
              <b class="block text-[11px]">{stage.title}</b>
              <small class="mt-0.5 block text-[8px] text-[#9298af]">
                {stage.note}
              </small>
            </>
          </li>
        ))
      }
    </ol>
  </div>
</section>
