---
import { Check } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url))("ages");
const cardStyles = [
  {
    surface: "border-[#cdeee3] bg-[#effbf9]",
    accent: "text-[#25b98a]",
    dot: "bg-[#25c58f]",
  },
  {
    surface: "border-[#cddff9] bg-[#f0f6ff]",
    accent: "text-[#4776dc]",
    dot: "bg-[#6689ec]",
  },
  {
    surface: "border-[#e0d3f7] bg-[#f7f1ff]",
    accent: "text-[#8b51d9]",
    dot: "bg-[#9b67e5]",
  },
];
---

<section
  id="age-groups"
  class="overflow-hidden bg-[#f9f9ff] py-18 md:py-20 lg:min-h-[534px]"
  aria-labelledby="ages-title"
>
  <div class="mx-auto w-[calc(100%-40px)] max-w-[1320px]">
    <header class="mx-auto mb-10 max-w-4xl text-center">
      <span
        class="mb-4 block text-[9px] font-extrabold tracking-[.32em] text-[#a5aaca] uppercase"
        >{t.eyebrow}</span
      >
      <h2
        id="ages-title"
        class="text-[30px] leading-[1.35] font-black text-brand sm:text-[40px] lg:text-[52px]"
      >
        {t.title}
      </h2>
      <span
        class="mx-auto mt-4 block h-1 w-14 rounded-full bg-[#5b64ed]"
        aria-hidden="true"></span>
      <p
        class="mx-auto mt-7 max-w-3xl text-sm leading-8 text-muted lg:text-base lg:leading-9"
      >
        {t.description}
      </p>
    </header>
    <div
      class="relative grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-10 md:before:absolute md:before:top-1/2 md:before:right-[8%] md:before:left-[8%] md:before:h-1 md:before:-translate-y-1/2 md:before:bg-[#9f73ee]"
    >
      {
        t.groups.map((group, index) => (
          <article
            class:list={[
              "relative z-10 mx-auto flex min-h-56 w-full max-w-md flex-row-reverse items-end overflow-hidden rounded-3xl border px-5 pt-5 shadow-[0_12px_30px_-24px_rgba(51,52,110,.35)] sm:px-6 md:min-h-[200px] md:max-w-none",
              cardStyles[index].surface,
            ]}
          >
            <img
              class="h-48 w-[36%] shrink-0 self-end object-contain object-bottom md:h-52 md:w-[38%]"
              src={group.image}
              width="562"
              height="1024"
              alt=""
              aria-hidden="true"
            />
            <div class="flex min-w-0 flex-1 flex-col self-center py-6 text-start">
              <span
                class:list={[
                  "text-xs font-extrabold md:text-sm",
                  cardStyles[index].accent,
                ]}
              >
                {group.age}
              </span>
              <h3 class="mt-3 text-sm leading-7 font-black text-ink md:text-base md:leading-8">
                {group.title}
              </h3>
              <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
                {group.skills.map((skill) => (
                  <span class="inline-flex items-center gap-1.5 text-[10px] font-bold whitespace-nowrap text-[#59627d] md:text-[11px]">
                    <span
                      class:list={[
                        "inline-flex size-4 items-center justify-center rounded-full text-white",
                        cardStyles[index].dot,
                      ]}
                    >
                      <Check size={10} stroke-width={3} aria-hidden="true" />
                    </span>
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
