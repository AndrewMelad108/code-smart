---
import { ArrowLeft, ArrowRight, ShieldCheck } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)("academy");
const Arrow = lang === "ar" ? ArrowLeft : ArrowRight;
---

<section
  id="academy"
  class="relative overflow-hidden bg-[#f7f7ff] py-20 md:py-24 lg:min-h-[968px] lg:pb-12"
  aria-labelledby="academy-title"
>
  <div class="mx-auto w-[calc(100%-32px)] sm:w-[calc(100%-60px)]">
    <div
      class="academy-layout grid grid-cols-1 items-center gap-14 lg:grid-cols-2 lg:items-start lg:gap-[62px] ltr:[direction:rtl] rtl:[direction:ltr]"
    >
      <figure
        class="relative m-0 mx-auto w-full max-w-[650px] pb-12 lg:mt-1 lg:pb-0"
      >
        <div
          class="overflow-hidden rounded-[24px] bg-[#e7e4ff] shadow-[0_22px_60px_-34px_rgba(76,49,134,.38)]"
        >
          <img
            class="aspect-[1.08] w-full object-cover sm:aspect-[.88] lg:aspect-[650/740]"
            src="/academy-classroom.jpg"
            width="1536"
            height="1024"
            alt={t.imageAlt}
          />
        </div>

        <figcaption
          class="absolute bottom-0 left-1/2 flex min-h-[108px] w-[min(500px,calc(100%-32px))] -translate-x-1/2 items-center justify-center gap-5 rounded-[18px] bg-white px-5 py-4 text-center shadow-[0_18px_45px_-24px_rgba(49,32,89,.28)] lg:-bottom-13 lg:min-h-[116px] ltr:[direction:ltr] rtl:[direction:rtl]"
        >
          <span
            class="flex size-16 shrink-0 items-center justify-center rounded-full bg-brand-gradient text-white shadow-button"
          >
            <ShieldCheck size={34} stroke-width={2.5} aria-hidden="true" />
          </span>
          <span class="min-w-0">
            <strong class="block text-[15px] font-black text-ink">
              {t.imageCaption}
            </strong>
            <span class="mt-1 block text-[10px] leading-[1.9] text-muted">
              {t.imageCaptionDescription}
            </span>
          </span>
        </figcaption>
      </figure>

      <div
        class="academy-copy text-center ltr:[direction:ltr] rtl:[direction:rtl]"
      >
        <p class="text-[9px] font-extrabold tracking-[.3em] text-[#9ba4c5]">
          {t.eyebrow}
        </p>

        <div class="mt-7 inline-flex flex-col items-center">
          <span class="text-[17px] font-black text-brand">{t.badge}</span>
          <span class="mt-3 h-0.5 w-10 rounded-full bg-brand" aria-hidden="true"
          ></span>
        </div>

        <h2
          id="academy-title"
          class="mt-8 text-[32px] leading-[1.45] font-black text-ink sm:text-[40px] lg:text-[44px] [:lang(en)_&]:leading-[1.18]"
        >
          <span class="block">{t.title}</span>
          <span class="block">{t.titleSecond}</span>
          <span class="block text-green">{t.highlight}</span>
        </h2>

        <p
          class="mx-auto mt-6 max-w-[540px] text-[13px] leading-[2.05] text-muted lg:text-[14px]"
        >
          {
            t.description.map((line) => (
              <span class="block text-center">{line}</span>
            ))
          }
        </p>

        <div class="academy-values mt-16 grid grid-cols-1 gap-3 sm:grid-cols-3">
          {
            t.values.map((value) => (
              <article class="flex min-h-[200px] items-center gap-4 rounded-[18px] bg-white px-5 py-5 text-start shadow-[0_14px_40px_-26px_rgba(49,32,89,.24)] sm:block sm:text-center">
                <img
                  class="size-16.5 shrink-0 object-contain sm:mx-auto"
                  src={value.image}
                  alt="{value.title}"
                  aria-hidden="true"
                />
                <div class="min-w-0 sm:mt-3">
                  <h3 class="text-base leading-[1.7] font-black text-ink">
                    {value.title}
                  </h3>
                  <p class="mt-1.5text-xs leading-[1.9] text-muted">
                    {value.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>

        <div
          class="academy-action relative mt-14 flex justify-center ltr:lg:ps-[75px] rtl:lg:pe-[75px]"
        >
          <a
            class="inline-flex min-h-16 items-center justify-center gap-2.5 rounded-[10px] bg-brand-gradient px-7 py-3 text-[13px] font-extrabold text-white shadow-button transition-transform hover:-translate-y-0.5"
            href="#future"
          >
            {t.cta}<Arrow size={18} stroke-width={2.2} aria-hidden="true" />
          </a>
          <span
            class="pointer-events-none absolute top-1/2 hidden h-12 w-24 -translate-y-1/2 border-t-2 border-dashed border-brand/45 lg:block ltr:left-2 ltr:rotate-[28deg] rtl:right-2 rtl:rotate-[-28deg]"
            aria-hidden="true"></span>
          <span
            class="pointer-events-none absolute top-[calc(50%-35px)] hidden size-2 rounded-full bg-brand/70 lg:block ltr:left-1 rtl:right-1"
            aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</section>
