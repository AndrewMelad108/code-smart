---
import {
  ArrowLeft,
  ArrowRight,
  BadgeCheck,
  CalendarDays,
  CirclePercent,
  Gift,
  Info,
  Rocket,
  Sparkles,
  Trophy,
  Users,
} from "@lucide/astro";
import { SIGNUP_URL } from "@/constants";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)("future");
const Arrow = lang === "ar" ? ArrowLeft : ArrowRight;
const statIcons = [Users, Gift, CirclePercent];
const statStyles = [
  {
    icon: "bg-[#eafbf2] text-[#19b867]",
    value: "text-[#15b866]",
    border: "border-[#e7e8f6]",
  },
  {
    icon: "bg-[#f0efff] text-[#6658ed]",
    value: "text-[#5b55e7]",
    border: "border-[#e7e8f6]",
  },
  {
    icon: "bg-[#eafbf2] text-[#19b867]",
    value: "text-[#15b866]",
    border: "border-[#22c776]",
  },
];
const stepIcons = [Users, CalendarDays, Trophy, Rocket];
const stepColors = [
  "text-[#6d63eb]",
  "text-[#4f6fec]",
  "text-[#f1a61b]",
  "text-[#19b867]",
];
---

<section
  id="future"
  class="relative overflow-hidden bg-[#f7f7ff] pt-20 pb-24 lg:min-h-[1074px]"
  aria-labelledby="future-title"
>
  <span
    class="pointer-events-none absolute top-2 left-[20%] size-2 rotate-45 bg-[#aeb8f5]"
    aria-hidden="true"></span>

  <div class="mx-auto w-[calc(100%-40px)] max-w-[1320px]">
    <div
      class="future-layout grid grid-cols-1 items-start gap-8 [direction:ltr] lg:grid-cols-[.95fr_1.05fr] lg:gap-14"
    >
      <div
        class="future-copy relative z-10 w-full pb-6 text-center lg:max-w-[540px] lg:justify-self-start lg:pt-6 lg:pb-0 ltr:[direction:ltr] rtl:[direction:rtl]"
      >
        <span
          class="mb-7 inline-flex items-center gap-2 rounded-full bg-[#7555ed] px-4 py-2 text-[11px] font-bold text-white shadow-[0_8px_20px_-8px_rgba(89,76,227,.75)]"
        >
          <Sparkles size={13} aria-hidden="true" />
          {t.badge}
        </span>

        <h2
          id="future-title"
          class="text-[34px] leading-[1.3] font-black text-[#12224f] sm:text-[38px] lg:text-[38px] lg:whitespace-nowrap"
        >
          {t.title}
          <bdi dir="ltr">{t.year}</bdi>
        </h2>
        <h3
          class="mt-5 text-[17px] leading-[1.75] font-black text-[#20bf68] sm:text-[18px] lg:text-[18px] lg:whitespace-nowrap"
        >
          {t.highlight}
        </h3>
        <p
          class="mx-auto mt-5 max-w-[610px] text-start text-xs leading-8 text-[#59627d] lg:mx-0 lg:text-[14px]"
        >
          {t.descriptionBefore}<strong class="font-black text-brand"
            >{t.descriptionAmount}</strong
          >{t.descriptionAfter}
        </p>

        <div
          class="future-stats mt-8 grid grid-cols-1 gap-3 [direction:ltr] sm:grid-cols-3"
        >
          {
            t.stats.map((stat, index) => {
              const StatIcon = statIcons[index];

              return (
                <article
                  class:list={[
                    "flex min-h-[150px] flex-col items-center justify-center rounded-2xl border bg-white px-4 py-5 text-center shadow-[0_12px_35px_-28px_rgba(34,39,94,.45)]",
                    statStyles[index].border,
                  ]}
                  dir={lang === "ar" ? "rtl" : "ltr"}
                >
                  <span
                    class:list={[
                      "flex size-10 items-center justify-center rounded-full",
                      statStyles[index].icon,
                    ]}
                  >
                    <StatIcon size={20} aria-hidden="true" />
                  </span>
                  <strong
                    class:list={[
                      "mt-2 block text-[24px] leading-none font-black",
                      statStyles[index].value,
                    ]}
                    dir="ltr"
                  >
                    {stat.value}
                  </strong>
                  <b class="mt-2 block text-[11px] text-[#182953]">
                    {stat.label}
                  </b>
                  <small class="mt-1 block text-[9px] text-muted">
                    {stat.note}
                  </small>
                </article>
              );
            })
          }
        </div>
      </div>

      <div
        class="future-image relative w-full max-w-[610px] self-start justify-self-end lg:pt-6"
      >
        <img
          class="w-full object-contain object-bottom lg:h-[525px] lg:object-cover lg:object-top"
          src="/future-student.jpg"
          width="1322"
          height="1190"
          alt={t.imageAlt}
        />
      </div>
    </div>

    <div
      class="future-grant relative z-20 mx-auto mt-6 grid max-w-[1100px] items-center overflow-hidden rounded-3xl border border-[#e5e5f6] bg-white px-6 py-7 shadow-[0_18px_45px_-30px_rgba(44,49,107,.38)] [direction:ltr] lg:-mt-8 lg:grid-cols-[1.15fr_76px_2fr] lg:px-9"
    >
      <div
        class="text-center lg:text-start ltr:[direction:ltr] rtl:[direction:rtl]"
      >
        <h3 class="text-base leading-7 font-black text-[#1b2c58]">
          {t.grantTitle}
          <bdi class="text-brand" dir="ltr">Code Smart</bdi>.
        </h3>
        <p class="mt-2 text-[11px] leading-6 text-muted">
          {t.grantDescription}
        </p>
        <strong class="mt-1 block text-[11px] text-[#18b965]"
          >{t.grantHighlight}</strong
        >
        <small class="mt-1 block text-[9px] text-muted">{t.grantNote}</small>
      </div>

      <span
        class="mx-auto my-6 flex size-14 items-center justify-center rounded-2xl bg-[#eeebff] text-[#7555ed] lg:my-0"
        aria-hidden="true"
      >
        <BadgeCheck size={29} />
      </span>

      <div
        class="grid grid-cols-2 sm:grid-cols-4 ltr:[direction:ltr] rtl:[direction:rtl]"
      >
        {
          t.steps.map((step, index) => {
            const StepIcon = stepIcons[index];

            return (
              <div class="flex min-h-24 flex-col items-center justify-center px-3 text-center [&+&]:border-s [&+&]:border-[#d8cdfd]">
                <span
                  class:list={[
                    "flex size-9 items-center justify-center rounded-full border border-[#e7e5f6] bg-white",
                    stepColors[index],
                  ]}
                >
                  <StepIcon size={17} aria-hidden="true" />
                </span>
                <b class="mt-2 text-[10px] leading-5 text-[#1c2c55]">
                  {step.title}
                </b>
                <small class="text-[8px] leading-4 text-muted">
                  {step.note}
                </small>
              </div>
            );
          })
        }
      </div>
    </div>

    <div class="future-action mx-auto mt-10 max-w-2xl text-center">
      <h3
        class="text-[24px] leading-9 font-black text-[#152552] lg:text-[30px]"
      >
        {t.question}
      </h3>
      <p class="mt-2 text-xs text-muted lg:text-sm">{t.questionNote}</p>
      <a
        class="mx-auto mt-5 inline-flex min-h-12 items-center justify-center gap-2.5 rounded-xl bg-brand-gradient px-7 py-3 text-xs font-extrabold text-white shadow-button transition-transform hover:-translate-y-0.5"
        href={SIGNUP_URL ?? "#home"}
        >{t.cta}<Arrow size={17} aria-hidden="true" /></a
      >
      <p
        class="mt-5 flex items-center justify-center gap-2 text-[9px] text-[#959bb0]"
      >
        <Info size={13} aria-hidden="true" />{t.terms}
      </p>
    </div>
  </div>
</section>
