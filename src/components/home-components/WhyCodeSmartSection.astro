---
import { Heart } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)("why");
const cardImages = [
  "/idea-lightbulb.png",
  "/learning-path-web.png",
  "/task-clipboard.png",
  "/graduation-cap.png",
];
const mobileIcons = ["🚀", "</>", "🗺️", "🎮"];
const cardAccents = [
  "text-[#ff7b2f]",
  "text-[#4f7cff]",
  "text-[#15c7aa]",
  "text-[#7b55ff]",
];
const cardPositions = ["lg:mt-20", "lg:mt-32", "lg:mt-28", "lg:mt-20"];
---

<section
  id="why-code-smart"
  class="relative overflow-hidden bg-[#f8f8ff] py-24 md:py-[88px]"
  aria-labelledby="why-title"
>
  <div class="mx-auto w-[calc(100%-60px)]">
    <header class="mx-auto mb-10 max-w-[820px] text-center md:mb-12">
      <span
        class="mb-3 block text-[11px] font-extrabold tracking-[.28em] text-[#94A3B8] uppercase"
        >{t.eyebrow}</span
      >
      <h2
        id="why-title"
        class="text-[30px] leading-[1.35] font-black text-[#0b1438] sm:text-[40px] lg:text-[50px]"
      >
        {t.titleBefore}{" "}<bdi class="text-brand" dir="ltr"
          >{t.titleBrand}</bdi
        >{t.titleAfter}
      </h2>
      <span class="mx-auto mt-4 block h-0.5 w-12 rounded-full bg-brand"></span>
      <p
        class="mx-auto mt-5 max-w-180 text-[12px] leading-7 text-muted lg:text-sm"
      >
        {t.description}
      </p>
    </header>

    <div
      class="relative mx-auto -mb-12 hidden h-28 max-w-[1300px] lg:block"
      aria-hidden="true"
    >
      <span
        class="absolute inset-x-[7%] top-16 h-24 rounded-[50%] border-t-2 border-[#d9e5ff]"
      ></span>
      {
        [
          "inset-s-[6%] text-[#ff7b2f]",
          "inset-s-[34%] text-[#4f7cff]",
          "inset-s-[63%] text-[#15c7aa]",
          "inset-e-[6%] text-[#7b55ff]",
        ].map((classes) => (
          <i
            class:list={[
              "absolute top-11 flex size-8 items-center justify-center rounded-full border border-current bg-white text-[9px] font-black shadow-card",
              classes,
            ]}
          >
            01
          </i>
        ))
      }
      <img
        class="absolute inset-s-1/2 -top-15 h-48.5 w-24 -translate-x-1/2 object-contain rtl:translate-x-1/2"
        src="/ai-assistant-robot.png"
        alt="assistant robot"
      />
    </div>
    <img
      src="/ai-assistant-robot.png"
      alt="assistant robot"
      class="why-robot mx-auto block h-39 w-33.5 lg:hidden"
    />
    <div
      class="why-cards relative z-10 mx-auto grid grid-cols-1 items-start gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-15"
    >
      {
        t.cards.map((card, index) => (
          <article
            class:list={[
              "min-h-48 rounded-[10px] border border-[#eef0fb] bg-white px-7 py-7 text-center shadow-card",
              "lg:min-h-60",
              cardPositions[index],
            ]}
          >
            <span
              class:list={[
                "mx-auto mb-5 flex size-14 items-center justify-center rounded-2xl bg-[#f4f6ff]",
                cardAccents[index],
              ]}
            >
              <img
                class="why-desktop-icon max-h-9 w-auto object-contain"
                src={cardImages[index]}
                width="56"
                height="56"
                alt=""
                aria-hidden="true"
              />
              <span class="why-mobile-icon" aria-hidden="true">
                {mobileIcons[index]}
              </span>
            </span>
            <>
              <small
                class:list={[
                  "mb-2 block text-[10px] font-black",
                  cardAccents[index],
                ]}
              >
                0{index + 1}
              </small>
              <h3 class="text-[15px] font-black text-[#1C3461]">
                {card.title}
              </h3>
              <p class="mt-3 text-[11px] leading-6 text-muted">
                {card.description}
              </p>
            </>
          </article>
        ))
      }
      <div
        class="absolute inset-s-[35%] top-14 -z-10 hidden w-20 lg:block"
        aria-hidden="true"
      >
        <img src="/code-smart-robot.png" width="160" height="192" alt="" />
      </div>
    </div>
    <div class="why-footer mx-auto mt-14 flex flex-col items-center">
      <div
        class="flex h-1.5 items-center justify-center gap-2"
        aria-hidden="true"
      >
        <span class="size-1 rounded-full bg-[#ddd6fe]"></span>
        <span
          class="h-px w-12 bg-[linear-gradient(90deg,rgba(221,214,254,0),#ddd6fe)]"
        ></span>
        <span class="size-1.5 rounded-full bg-[#c4b5fd]"></span>
        <span
          class="h-px w-12 bg-[linear-gradient(90deg,#ddd6fe,rgba(221,214,254,0))]"
        ></span>
        <span class="size-1 rounded-full bg-[#ddd6fe]"></span>
      </div>
      <div class="mt-2 flex h-11 items-center justify-center text-[#7c3aed]">
        <Heart
          size={22}
          fill="currentColor"
          stroke-width={0}
          aria-hidden="true"
        />
      </div>
      <p
        class="flex min-h-15 w-100 max-w-full items-center justify-center rounded-full border border-[#f1f5f9] bg-white px-6 text-center text-[18px] leading-[27px] font-semibold text-[#334155] shadow-[0_1px_4px_rgba(0,0,0,.04),0_4px_24px_rgba(124,58,237,.09)]"
      >
        {t.footer}
        <span class="ms-1 text-[#7C3AED]">
          {t.footerHighlight}
        </span>
      </p>
    </div>
  </div>
</section>
