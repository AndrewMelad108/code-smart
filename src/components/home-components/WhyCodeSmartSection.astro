---
import { Heart } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)("why");

const mobileIcons = ["🚀", "</>", "🗺️", "🎮"];
const cardAccents = [
  "text-[#7b55ff]",
  "text-[#15c7aa]",
  "text-[#4f7cff]",
  "text-[#ff7b2f]",
];
const cardPositions = ["lg:mt-20", "lg:mt-32", "lg:mt-28", "lg:mt-20"];
---

<section
  id="why-code-smart"
  class="relative overflow-hidden bg-[#f8f8ff] py-24 md:py-[88px]"
  aria-labelledby="why-title"
>
  <div class="mx-auto w-[calc(100%-60px)]">
    <header class="mx-auto mb-10 max-w-[820px] text-center md:mb-12">
      <span
        class="mb-3 block text-[11px] font-extrabold tracking-[.28em] text-[#94A3B8] uppercase"
        >{t.eyebrow}</span
      >
      <h2
        id="why-title"
        class="text-[30px] leading-[1.35] font-black text-[#0b1438] sm:text-[40px] lg:text-[50px]"
      >
        {t.titleBefore}{" "}<bdi
          class="bg-linear-to-r from-[#3B82F6] to-[#7C3AED] bg-clip-text text-transparent"
          dir="ltr">{t.titleBrand}</bdi
        >{t.titleAfter}
      </h2>
      <span
        class="mx-auto mt-4 block h-0.5 w-12 rounded-full bg-linear-to-r from-[#3B82F6] to-[#7C3AED]"
      ></span>
      <p
        class="mx-auto mt-5 w-130 text-[12px] leading-7 text-[#475569] lg:text-[19px] lg:leading-9"
      >
        {t.description}
      </p>
    </header>

    <!-- Desktop Timeline - lg+ only -->
    <div
      class="relative mx-auto -mb-8 hidden w-full max-w-[1300px] lg:block"
      aria-hidden="true"
    >
      <div class="relative aspect-10/1 w-full">
        <svg
          viewBox="0 0 1300 130"
          class="absolute inset-0 h-full w-full"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <!-- Left side: Orange -> light -> Blue -->
            <linearGradient
              id="leftTimeline"
              x1="80"
              y1="50"
              x2="560"
              y2="65"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0%" stop-color="#FF6B2C"></stop>
              <stop offset="42%" stop-color="#E8ECF7"></stop>
              <stop offset="72%" stop-color="#DCE5FF"></stop>
              <stop offset="100%" stop-color="#4F7CFF"></stop>
            </linearGradient>

            <!-- Right side: Cyan -> light -> Purple -->
            <linearGradient
              id="rightTimeline"
              x1="740"
              y1="65"
              x2="1220"
              y2="50"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0%" stop-color="#15C7AA"></stop>
              <stop offset="30%" stop-color="#DCECF1"></stop>
              <stop offset="62%" stop-color="#E8ECF7"></stop>
              <stop offset="100%" stop-color="#7B55FF"></stop>
            </linearGradient>
          </defs>

          <!-- LEFT CURVE -->
          <path
            d="
          M 80 48
          C 170 48, 280 88, 450 88
          C 500 88, 530 68, 560 64
        "
            stroke="url(#leftTimeline)"
            stroke-width="2"
            stroke-linecap="round"></path>

          <!-- RIGHT CURVE -->
          <path
            d="
          M 740 64
          C 770 68, 800 88, 850 88
          C 1020 88, 1130 48, 1220 48
        "
            stroke="url(#rightTimeline)"
            stroke-width="2"
            stroke-linecap="round"></path>

          <!-- ================= -->
          <!-- 04 -->
          <!-- ================= -->
          <circle
            cx="80"
            cy="48"
            r="20"
            fill="white"
            stroke="#FF6B2C"
            stroke-width="1.5"></circle>

          <text
            x="80"
            y="51"
            text-anchor="middle"
            dominant-baseline="middle"
            fill="#FF6B2C"
            font-size="9"
            font-weight="800"
          >
            04
          </text>

          <circle
            cx="80"
            cy="77"
            r="3.5"
            fill="white"
            stroke="#FF6B2C"
            stroke-width="1.5"></circle>

          <!-- ================= -->
          <!-- 03 -->
          <!-- ================= -->
          <circle
            cx="450"
            cy="88"
            r="20"
            fill="white"
            stroke="#4F7CFF"
            stroke-width="1.5"></circle>

          <text
            x="450"
            y="91"
            text-anchor="middle"
            dominant-baseline="middle"
            fill="#4F7CFF"
            font-size="9"
            font-weight="800"
          >
            03
          </text>

          <circle
            cx="450"
            cy="117"
            r="3.5"
            fill="white"
            stroke="#4F7CFF"
            stroke-width="1.5"></circle>

          <!-- ================= -->
          <!-- 02 -->
          <!-- ================= -->
          <circle
            cx="850"
            cy="88"
            r="20"
            fill="white"
            stroke="#15C7AA"
            stroke-width="1.5"></circle>

          <text
            x="850"
            y="91"
            text-anchor="middle"
            dominant-baseline="middle"
            fill="#15C7AA"
            font-size="9"
            font-weight="800"
          >
            02
          </text>

          <circle
            cx="850"
            cy="117"
            r="3.5"
            fill="white"
            stroke="#15C7AA"
            stroke-width="1.5"></circle>

          <!-- ================= -->
          <!-- 01 -->
          <!-- ================= -->
          <circle
            cx="1220"
            cy="48"
            r="20"
            fill="white"
            stroke="#7B55FF"
            stroke-width="1.5"></circle>

          <text
            x="1220"
            y="51"
            text-anchor="middle"
            dominant-baseline="middle"
            fill="#7B55FF"
            font-size="9"
            font-weight="800"
          >
            01
          </text>

          <circle
            cx="1220"
            cy="77"
            r="3.5"
            fill="white"
            stroke="#7B55FF"
            stroke-width="1.5"></circle>
        </svg>

        <!-- Center robot -->
        <img
          src="/ai-assistant-robot.png"
          alt=""
          class="pointer-events-none absolute top-[-18px] left-1/2 z-10 w-[90px] -translate-x-1/2 object-contain xl:h-[194px] xl:w-[165px]"
        />
      </div>
    </div>

    <img
      src="/ai-assistant-robot.png"
      alt="assistant robot"
      class="why-robot mx-auto block h-39 w-33.5 lg:hidden"
    />
    <div
      class="why-cards relative z-10 mx-auto grid grid-cols-1 items-start gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-15"
    >
      {
        t.cards.map((card, index) => (
          <article
            class:list={[
              "min-h-48 rounded-[10px] border border-[#eef0fb] bg-white px-7 py-7 text-center shadow-card",
              "lg:min-h-60",
              cardPositions[index],
            ]}
          >
            <span
              class:list={[
                "mx-auto mb-5 flex size-14 items-center justify-center rounded-2xl bg-[#f4f6ff]",
                cardAccents[index],
              ]}
            >
              <span
                class="why-desktop-icon flex h-9 w-9 items-center justify-center text-2xl"
                aria-hidden="true"
              >
                {mobileIcons[index]}
              </span>
              <span class="why-mobile-icon" aria-hidden="true">
                {mobileIcons[index]}
              </span>
            </span>
            <>
              <small
                class:list={[
                  "mb-2 block text-[10px] font-black",
                  cardAccents[index],
                ]}
              >
                0{index + 1}
              </small>
              <h3 class="text-sm font-black text-[#1C3461] lg:text-lg">
                {card.title}
              </h3>
              <p class="mt-3 text-xs leading-6 text-muted lg:text-sm">
                {card.description}
              </p>
            </>
          </article>
        ))
      }
      <div
        class="absolute inset-s-[35%] top-14 -z-10 hidden w-20 lg:block"
        aria-hidden="true"
      >
        <img src="/code-smart-robot.png" width="160" height="192" alt="" />
      </div>
    </div>

    <!-- Footer -->
    <div class="why-footer mx-auto mt-14 flex flex-col items-center">
      <div
        class="flex h-1.5 items-center justify-center gap-2"
        aria-hidden="true"
      >
        <span class="size-1 rounded-full bg-[#ddd6fe]"></span>
        <span
          class="h-px w-12 bg-[linear-gradient(90deg,rgba(221,214,254,0),#ddd6fe)]"
        ></span>
        <span class="size-1.5 rounded-full bg-[#c4b5fd]"></span>
        <span
          class="h-px w-12 bg-[linear-gradient(90deg,#ddd6fe,rgba(221,214,254,0))]"
        ></span>
        <span class="size-1 rounded-full bg-[#ddd6fe]"></span>
      </div>
      <div class="mt-2 flex h-11 items-center justify-center text-[#7c3aed]">
        <Heart
          size={22}
          fill="currentColor"
          stroke-width={0}
          aria-hidden="true"
        />
      </div>
      <p
        class="flex min-h-15 w-100 max-w-full items-center justify-center rounded-full border border-[#f1f5f9] bg-white px-6 text-center text-[18px] leading-[27px] font-semibold text-[#334155] shadow-[0_1px_4px_rgba(0,0,0,.04),0_4px_24px_rgba(124,58,237,.09)]"
      >
        {t.footer}
        <span class="ms-1 text-[#7C3AED]">
          {t.footerHighlight}
        </span>
      </p>
    </div>
  </div>
</section>
