<script>
  document.querySelectorAll<HTMLElement>(".roadmap-scene").forEach((scene) => {
    const svg = scene.querySelector<SVGSVGElement>(".roadmap-connectors");
    const choice = scene.querySelector<HTMLElement>(".roadmap-choice");
    const cards = [...scene.querySelectorAll<HTMLElement>(".roadmap-card")];
    if (!svg || !choice) return;
    const paths = svg.querySelectorAll("path[data-link]");
    const update = () => {
      const bounds = scene.getBoundingClientRect(),
        c = choice.getBoundingClientRect();
      if (!bounds.width || !bounds.height) return;
      svg.setAttribute("viewBox", `0 0 ${bounds.width} ${bounds.height}`);
      const desktop = matchMedia("(min-width:1280px)").matches;
      const spread = desktop
        ? Math.min(1, Math.max(0, (innerWidth - 1280) / 160))
        : 0;
      cards.forEach((card, index) => {
        const r = card.getBoundingClientRect();
        let d;
        if (desktop) {
          const left = r.left + r.width / 2 < c.left + c.width / 2;
          const x1 = (left ? r.right : r.left) - bounds.left,
            x2 = (left ? c.left : c.right) - bounds.left;
          const y2 =
            c.top -
            bounds.top +
            (index === 0
              ? 120 - 18 * spread
              : index === 1
                ? 20 + 72 * spread
                : 219 + 15 * spread);
          const y1 =
            y2 +
            (index === 0
              ? 37 * spread
              : index === 1
                ? -85 * spread
                : -89 * spread);
          const midpoint = (x1 + x2) / 2;
          d = `M ${x1} ${y1} C ${midpoint} ${y1} ${midpoint} ${y2} ${x2} ${y2}`;
        } else if (index === 0) {
          const platform = scene
            .querySelector<HTMLElement>(".beginner-platform")!
            .getBoundingClientRect();
          const rtl = document.documentElement.dir === "rtl",
            x1 = (rtl ? platform.right - 8 : platform.left + 8) - bounds.left,
            y1 = platform.bottom - bounds.top;
          const x2 = (rtl ? c.right : c.left) - bounds.left,
            y2 = c.top + 32 - bounds.top,
            bend = x1 + (rtl ? 70 : -70);
          d = `M ${x1} ${y1} C ${bend} ${y1} ${bend} ${y2} ${x2} ${y2}`;
        } else {
          const art = scene
            .querySelector<HTMLElement>(".mobile-roadmap-art")
            ?.getBoundingClientRect();
          const x =
            c.left + c.width * (index === 1 ? 0.69 : 0.255) - bounds.left;
          const y = c.bottom - bounds.top;
          const x2 =
            art && art.width
              ? art.left + art.width * (index === 1 ? 0.455 : 0.4) - bounds.left
              : x;
          const y2 = art && art.height ? art.top - bounds.top + 20 : y + 53;
          d = `M ${x} ${y} C ${x} ${y + 24} ${x2} ${y2 - 10} ${x2} ${y2}`;
        }
        paths[index]?.setAttribute("d", d);
        if (index === 2)
          paths[index]?.setAttribute(
            "stroke",
            desktop && spread < 1 ? "#905aef" : "#7c3aed",
          );
      });
    };
    const observer = new ResizeObserver(update);
    [scene, choice, ...cards].forEach((e) => observer.observe(e));
    update();
  });
</script>
