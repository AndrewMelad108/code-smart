---
import {
  ArrowUpLeft,
  ArrowUpRight,
  Braces,
  Check,
  Gamepad2,
  GitBranch,
  Globe,
} from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)("learning");
const Arrow = lang === "ar" ? ArrowUpLeft : ArrowUpRight;
const visibleTracks = [t.tracks[2], t.tracks[1], t.tracks[0]];
const trackStyles = [
  {
    position:
      "order-2 lg:absolute lg:top-[8%] lg:min-h-[380px] lg:w-[280px] lg:order-none rtl:lg:left-[29%] ltr:lg:right-[29%]",
    number: "bg-[#3156d9]",
    icon: "bg-[#eef3ff] text-[#3156d9]",
    check: "text-[#6d82ef]",
    Icon: Braces,
  },
  {
    position:
      "order-3 lg:absolute lg:top-[51%] lg:min-h-[370px] lg:w-[280px] lg:order-none rtl:lg:left-[29%] ltr:lg:right-[29%]",
    number: "bg-[#7050e8]",
    icon: "bg-[#f2efff] text-[#7050e8]",
    check: "text-[#8b6cf1]",
    Icon: Globe,
  },
  {
    position:
      "order-1 lg:absolute lg:top-[32%] lg:min-h-[380px] lg:w-[280px] lg:order-none rtl:lg:right-0 ltr:lg:left-0",
    number: "bg-[#20bf6b]",
    icon: "bg-[#eafaf2] text-[#178c5a]",
    check: "text-[#21c979]",
    Icon: Gamepad2,
  },
];
---

<section
  id="learning-path"
  class="relative overflow-hidden bg-[#f7f7ff] pt-20 pb-24"
  aria-labelledby="learning-title"
>
  <div class="mx-auto w-[calc(100%-40px)] max-w-[1320px]">
    <header class="mx-auto mb-10 max-w-[820px] text-center">
      <span
        class="mb-3 block text-[8px] font-extrabold tracking-[.32em] text-[#afb3ca] uppercase"
        >{t.eyebrow}</span
      >
      <h2
        id="learning-title"
        class="text-[34px] leading-[1.25] font-black text-brand sm:text-[46px] lg:text-[64px]"
      >
        {t.title}
      </h2>
      <span
        class="mx-auto mt-4 block h-0.5 w-14 rounded-full bg-[#5368ef]"
        aria-hidden="true"
      ></span>
      <p class="mx-auto mt-5 max-w-180 text-xs leading-7 text-muted lg:text-sm">
        {t.description}
      </p>
    </header>

    <div class="relative mx-auto lg:h-[1030px]">
      <img
        class="absolute top-[2%] z-0 hidden w-[58%] object-contain rtl:-scale-x-100 rtl:lg:-left-[3%] ltr:lg:-right-[3%] lg:block"
        src="/learning-path-python.png"
        width="1536"
        height="1024"
        alt={t.imageAltPython}
      />
      <img
        class="absolute bottom-[-8%] z-0 hidden w-[104%] object-contain rtl:-scale-x-100 rtl:lg:-right-[3%] ltr:lg:-left-[3%] lg:block"
        src="/learning-path-web.png"
        width="2000"
        height="711"
        alt={t.imageAltWeb}
      />
      <img
        class="absolute top-[-9%] z-20 hidden w-[305px] rtl:lg:right-0 ltr:lg:left-0 lg:block"
        src="/learning-student-robot.png"
        width="680"
        height="680"
        alt=""
        aria-hidden="true"
      />
      <img
        class="absolute bottom-[9%] z-10 hidden w-20 rtl:lg:right-[9%] ltr:lg:left-[9%] lg:block"
        src="/assistant-robot.png"
        width="160"
        height="192"
        alt=""
        aria-hidden="true"
      />

      <span
        class:list={[
          "absolute top-[29%] z-10 hidden text-center text-xs leading-4 font-black text-brand lg:block",
          lang === "ar" ? "left-0" : "right-0",
        ]}
        dir="ltr"
      >
        Python<br />Programmer
      </span>
      <span
        class:list={[
          "absolute bottom-[8%] z-10 hidden text-center text-xs leading-4 font-black text-brand lg:block",
          lang === "ar" ? "left-0" : "right-0",
        ]}
        dir="ltr"
      >
        Junior<br />Front-End<br />Developer
      </span>

      <svg
        class="pointer-events-none absolute inset-0 z-20 hidden h-full w-full ltr:-scale-x-100 lg:block"
        viewBox="0 0 1320 1030"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M 660 340 C 705 350 720 400 756 430"
          fill="none"
          stroke="#6877ed"
          stroke-width="2"
          stroke-dasharray="6 7"
        ></path>
        <path
          d="M 660 570 C 705 560 725 520 756 505"
          fill="none"
          stroke="#7758eb"
          stroke-width="2"
          stroke-dasharray="6 7"
        ></path>
        <path
          d="M 960 505 C 995 505 1010 525 1040 540"
          fill="none"
          stroke="#36cda4"
          stroke-width="2"
          stroke-dasharray="6 7"
        ></path>
      </svg>

      <div
        class="relative z-30 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:block lg:h-full"
      >
        {
          visibleTracks.map((track, index) => {
            const TrackIcon = trackStyles[index].Icon;

            return (
              <article
                class:list={[
                  "relative mx-auto flex min-h-80 w-full max-w-sm flex-col rounded-3xl border border-[#e5e6f5] bg-white p-7 text-center shadow-[0_16px_45px_-28px_rgba(48,48,110,.32)]",
                  trackStyles[index].position,
                  index === 2 &&
                    "border-[#7cddb1] shadow-[0_18px_50px_-30px_rgba(33,201,121,.45)]",
                ]}
              >
                <span
                  class:list={[
                    "absolute -top-5 rounded-lg px-3 py-2 text-xs font-black text-white shadow-sm",
                    lang === "ar" ? "right-3" : "left-3",
                    trackStyles[index].number,
                  ]}
                  dir="ltr"
                >
                  {track.number}
                </span>
                <span
                  class:list={[
                    "mx-auto flex size-16 shrink-0 items-center justify-center rounded-full",
                    trackStyles[index].icon,
                  ]}
                >
                  <TrackIcon size={27} stroke-width={1.8} aria-hidden="true" />
                </span>
                <p
                  class:list={[
                    "mt-6 text-[11px] font-bold",
                    index === 2 ? "text-[#16945e]" : "text-brand",
                  ]}
                  dir="ltr"
                >
                  {track.subtitle}
                </p>
                <h3 class="mt-2 text-xl leading-8 font-black text-[#1C3461]">
                  {track.title}
                </h3>
                <ul
                  class="mt-6 grid list-none gap-3 p-0 text-left text-xs text-[#53617b]"
                  dir="ltr"
                >
                  {track.skills.map((skill) => (
                    <li class="flex items-center gap-2">
                      <span class="flex size-4 items-center justify-center rounded-full bg-[#f1f3ff]">
                        <Check
                          class={trackStyles[index].check}
                          size={11}
                          stroke-width={3}
                          aria-hidden="true"
                        />
                      </span>
                      {skill}
                    </li>
                  ))}
                </ul>
                <span
                  class:list={[
                    "mt-auto rounded-full px-3 py-1.5 text-[9px] font-bold rtl:self-start ltr:self-end",
                    index === 2
                      ? "bg-[#edfbf4] text-[#16945e]"
                      : "bg-[#f3f1ff] text-brand",
                  ]}
                >
                  {index === 2 ? t.beginnerAge : t.advancedAge}
                </span>
              </article>
            );
          })
        }
      </div>

      <div
        class="relative z-40 mx-auto mt-5 flex min-h-52 w-full max-w-sm flex-col items-center justify-center rounded-3xl border border-[#dfddfb] bg-white/95 p-6 text-center text-[#1C3461] shadow-[0_16px_45px_-28px_rgba(48,48,110,.32)] sm:col-span-2 lg:absolute lg:top-[38%] lg:mt-0 lg:min-h-[230px] lg:w-[208px] rtl:lg:left-[57%] ltr:lg:right-[57%]"
      >
        <span
          class="flex size-16 items-center justify-center rounded-full bg-[#f3f0ff] text-[#7657eb]"
        >
          <GitBranch size={28} aria-hidden="true" />
        </span>
        <h3 class="mt-5 text-lg leading-8 font-black">{t.certificate}</h3>
        <p class="mt-3 text-[10px] leading-5 text-muted">
          {t.certificateNote}<strong class="block text-brand"
            >{t.certificateHighlight}</strong
          >
        </p>
      </div>
    </div>

    <div
      class="relative mx-auto mt-16 flex w-full max-w-[840px] flex-col items-center justify-between gap-4 sm:flex-row"
      dir="ltr"
    >
      <span
        class="absolute inset-x-[8%] top-1/2 hidden border-t-2 border-dashed border-[#7566e9]/35 sm:block"
        aria-hidden="true"
      ></span>
      <span
        class="relative z-10 inline-flex min-h-[92px] w-full max-w-[370px] items-center justify-center gap-5 rounded-2xl bg-brand-gradient px-7 py-4 text-center text-white shadow-[0_14px_30px_-12px_rgba(89,76,227,.55)]"
      >
        <span dir={lang === "ar" ? "rtl" : "ltr"}>
          <small class="block text-[10px] font-semibold text-white/75"
            >{t.certificateLabel}</small
          >
          <strong class="mt-1 block text-sm font-black" dir="ltr"
            >{t.junior}</strong
          >
        </span>
        <img
          class="h-9 w-8 object-contain"
          src="/reward-points-trophy.png"
          alt=""
          aria-hidden="true"
        />
      </span>
      <span
        class="relative z-10 inline-flex min-h-[92px] w-full max-w-[370px] items-center justify-center gap-5 rounded-2xl bg-brand-gradient px-7 py-4 text-center text-white shadow-[0_14px_30px_-12px_rgba(89,76,227,.55)]"
      >
        <span dir={lang === "ar" ? "rtl" : "ltr"}>
          <small class="block text-[10px] font-semibold text-white/75"
            >{t.certificateLabel}</small
          >
          <strong class="mt-1 block text-sm font-black" dir="ltr"
            >{t.senior}</strong
          >
        </span>
        <img
          class="h-9 w-8 object-contain"
          src="/reward-points-trophy.png"
          alt=""
          aria-hidden="true"
        />
      </span>
    </div>

    <a
      class="mx-auto mt-9 flex min-h-12 w-fit items-center justify-center gap-2.5 rounded-xl bg-brand-gradient px-7 py-3 text-xs font-extrabold text-white shadow-button transition-transform hover:-translate-y-0.5"
      href="#age-groups">{t.cta}<Arrow size={18} aria-hidden="true" /></a
    >
  </div>
</section>
