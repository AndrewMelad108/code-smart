---
import { ArrowUpLeft, ArrowUpRight, Check, GitBranch } from "@lucide/astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)("learning");
const Arrow = lang === "ar" ? ArrowUpLeft : ArrowUpRight;
const tracks = [t.tracks[0], t.tracks[2], t.tracks[1]];
const kinds = ["beginner", "python", "web"];
const colors = ["#10b981", "#3b5bdb", "#7c3aed"];
---

<section id="learning-path" aria-labelledby="learning-title">
  <header class="roadmap-heading">
    <span>{t.eyebrow}</span>
    <h2 id="learning-title">{t.title}</h2>
    <i></i>
    <p>{t.description}</p>
  </header>

  <div class="roadmap-scene">
    <img
      class="beginner-route"
      src="/Line%2060.png"
      alt=""
      width="47"
      height="231"
    />
    <div class="roadmap-art python-art hidden lg:block">
      <img src="/learning-path-python.png" width="1536" height="1024" alt="" />
    </div>
    <div class="roadmap-art web-art hidden lg:block">
      <img src="/learning-path-web.png" width="2000" height="711" alt="" />
    </div>
    <div class="mobile-roadmap-art">
      <img
        src="/green-learning-path-2.png"
        width="1536"
        height="1024"
        alt=""
        aria-hidden="true"
      />
    </div>
    <img
      class="student-robot"
      src="/learning-student-robot.png"
      width="680"
      height="680"
      alt=""
    />
    <img
      class="python-robot"
      src="/assistant-robot.png"
      width="160"
      height="220"
      alt=""
    />
    <img
      class="web-robot"
      src="/assistant-robot.png"
      width="160"
      height="220"
      alt=""
    />
    <img
      class="beginner-platform"
      src="/green-learning-path.png"
      width="1364"
      height="1153"
      alt=""
    />
    <span class="destination-label python-label" dir="ltr"
      >Python<br />Programmer</span
    >
    <span class="destination-label web-label" dir="ltr"
      >Junior<br />Front-End<br />Developer</span
    >

    <svg class="roadmap-connectors" aria-hidden="true">
      <defs>
        {
          colors.map((color, index) => (
            <>
              <marker
                id={`roadmap-dot-${index}`}
                viewBox="0 0 6 6"
                refX="3"
                refY="3"
                markerWidth="6"
                markerHeight="6"
                markerUnits="userSpaceOnUse"
              >
                <circle cx="3" cy="3" r="3" fill={color} />
              </marker>
              <marker
                id={`roadmap-arrow-${index}`}
                viewBox="0 0 8 8"
                refX="7"
                refY="4"
                markerWidth="8"
                markerHeight="8"
                orient="auto"
                markerUnits="userSpaceOnUse"
              >
                <path d="M 0 0 L 8 4 L 0 8 Z" fill={color} />
              </marker>
            </>
          ))
        }
      </defs>
      <path data-link="beginner" fill="none" stroke="#10b981"></path>
      <path data-link="python" fill="none" stroke="#3b5bdb"></path>
      <path data-link="web" fill="none" stroke="#7c3aed"></path>
    </svg>

    {
      tracks.map((track, index) => (
        <article
          class:list={["roadmap-card", `${kinds[index]}-card`]}
          data-track={kinds[index]}
          style={`--accent:${colors[index]}`}
        >
          <span class="track-number" dir="ltr">
            {track.number}
          </span>
          <div class="track-heading">
            <span class="track-icon">
              {index === 1 ? (
                <img src="/python-original.svg" width="28" height="28" alt="" />
              ) : (
                <span>{index === 0 ? "🎮" : "🌐"}</span>
              )}
            </span>
            <div class="track-titles">
              <>
                <p dir="ltr">{track.subtitle}</p>
                <h3>{track.title}</h3>
              </>
            </div>
          </div>
          <ul dir="ltr">
            {(index === 0
              ? [
                  track.skills[0],
                  track.skills[2],
                  track.skills[1],
                  track.skills[3],
                ]
              : track.skills
            ).map((skill) => (
              <li>
                <span>
                  <Check size={12} stroke-width={2.5} />
                </span>
                {skill}
              </li>
            ))}
          </ul>
          <span class="track-age">
            {index === 0 ? t.beginnerAge : t.advancedAge}
          </span>
        </article>
      ))
    }

    <div class="roadmap-choice">
      <span class="choice-icon"><GitBranch size={28} stroke-width={2.2} /></span
      >
      <div>
        <h3>{t.certificate}</h3><p>
          {
            lang === "ar" ? (
              <>
                اختر مسارك حسب
                <br />
                <strong class="choice-interests">ميولك واهتماماتك</strong>
              </>
            ) : (
              <>
                Choose your path around
                <br />
                your interests and goals
              </>
            )
          }
        </p>
      </div>
    </div>
    <span class="roadmap-spark"></span>
  </div>

  <div class="roadmap-destinations" dir="ltr">
    {
      [t.junior, t.senior].map((title) => (
        <div class="roadmap-destination">
          <>
            <span dir={lang === "ar" ? "rtl" : "ltr"}>
              <>
                <small>{t.certificateLabel}</small>
                <strong dir="ltr">{title}</strong>
              </>
            </span>
            <span class="destination-trophy">🏆</span>
          </>
        </div>
      ))
    }
  </div>
  <a class="roadmap-cta bg-brand-gradient" href="#age-groups"
    >{t.cta}<Arrow size={20} /></a
  >
</section>

<style>
  #learning-path {
    background: #f4f6ff;
    padding: 20px 0 28px;
  }
  .roadmap-heading {
    text-align: center;
    padding: 0 16px;
  }
  .roadmap-heading > span {
    display: block;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
    line-height: 17px;
    letter-spacing: 3px;
  }
  .roadmap-heading h2 {
    margin-top: 24px;
    font-size: 32px;
    line-height: 48px;
    font-weight: 900;
    background: linear-gradient(130deg, #3b82f6, #7c3aed);
    background-clip: text;
    color: transparent;
  }
  .roadmap-heading i {
    display: block;
    width: 56px;
    height: 2.5px;
    margin: 18px auto;
    background: #6366f1;
  }
  .roadmap-heading p {
    font-size: 14px;
    line-height: 28px;
    color: #475569;
  }
  .roadmap-scene {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    width: calc(100% - 40px);
    max-width: 640px;
    margin: 60px auto 0;
    isolation: isolate;
  }
  .roadmap-card {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: 281px;
    max-width: 100%;
    min-height: 326px;
    padding: 28px 20px 16px;
    border: 0.5px solid color-mix(in srgb, var(--accent) 60%, white);
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 8px 24px -18px #4338ca38;
  }
  .beginner-card {
    grid-row: 1;
    justify-self: end;
    margin-inline-start: min(28%, 119px);
  }
  .python-card {
    grid-row: 4;
    justify-self: center;
  }
  .web-card {
    grid-row: 5;
    justify-self: center;
  }
  .track-number {
    position: absolute;
    top: -23px;
    right: 12px;
    display: grid;
    place-items: center;
    min-width: 42px;
    height: 36px;
    padding: 0 8px;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    font-size: 16px;
    font-weight: 900;
    line-height: 36px;
  }
  :global(html[dir="ltr"]) .track-number {
    right: auto;
    left: 12px;
  }
  .track-heading {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .track-titles {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
  }
  .track-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 7%, white);
    color: var(--accent);
    font-size: 24px;
    line-height: 32px;
  }
  .track-icon img {
    width: 28px;
    height: 28px;
  }
  .track-titles h3 {
    order: -1;
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    color: #1c3461;
  }
  .track-titles p {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
    color: var(--accent);
  }
  .roadmap-card ul {
    display: grid;
    gap: 20px;
    margin: 24px auto 20px;
    padding: 0;
    list-style: none;
    color: #1c3461;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
  }
  .roadmap-card li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .roadmap-card li > span {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 12%, white);
    color: var(--accent);
  }
  .track-age {
    align-self: flex-start;
    margin-top: auto;
    padding: 4px 12px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--accent) 6%, white);
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
  }
  .roadmap-choice {
    position: relative;
    z-index: 2;
    grid-row: 2;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 20px;
    width: 340px;
    max-width: 100%;
    min-height: 128px;
    padding: 20px;
    border: 1px solid #e4dfff;
    border-radius: 24px;
    background: white;
    text-align: start;
  }
  .choice-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #f5f3ff;
    color: #673de6;
  }
  .roadmap-choice h3 {
    font-size: 20px;
    line-height: 24px;
    font-weight: 600;
    color: #172554;
  }
  .roadmap-choice p {
    font-size: 14px;
    line-height: 28px;
    font-weight: 400;
    color: #6b7280;
    margin-top: 8px;
  }
  .roadmap-art {
    pointer-events: none;
  }
  .roadmap-art img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: fill;
  }
  .python-art,
  .student-robot,
  .python-robot,
  .destination-label,
  .roadmap-spark {
    display: none;
  }
  .web-art {
    grid-row: 3;
    justify-self: center;
    width: 100%;
    max-width: 558px;
    aspect-ratio: 392/228;
    display: grid;
    place-items: center;
  }
  .web-art img {
    height: auto;
  }
  :global(html[dir="rtl"]) .roadmap-art {
    transform: scaleX(-1);
  }
  .web-robot {
    position: absolute;
    top: 145px;
    inset-inline-start: 4px;
    width: 80px;
    height: 110px;
    max-width: 22%;
    object-fit: contain;
    z-index: 1;
  }
  .beginner-platform {
    position: absolute;
    top: 205px;
    inset-inline-start: 0;
    width: 119px;
    height: 87px;
    max-width: 28%;
    object-fit: contain;
  }
  .roadmap-connectors {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }
  .roadmap-connectors path {
    stroke-width: 1.7643;
    stroke-dasharray: 6.0357 4.6429;
    opacity: 0.82;
    vector-effect: non-scaling-stroke;
  }
  .roadmap-destinations {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    width: calc(100% - 40px);
    max-width: 836px;
    margin: 40px auto 0;
  }
  .roadmap-destinations::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 46px;
    bottom: 46px;
    border-left: 2px dashed #b6a8f2;
  }
  .roadmap-destination {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    width: 368px;
    max-width: 100%;
    min-height: 92px;
    padding: 20px;
    border-radius: 16px;
    background: linear-gradient(120deg, #3b5bdb, #6d29e9);
    color: #fff;
    box-shadow: 0 8px 20px -8px #594ce380;
  }
  .roadmap-destination small {
    display: block;
    font-size: 14px;
    line-height: 20px;
  }
  .roadmap-destination strong {
    display: block;
    margin-top: 4px;
    font-size: clamp(14px, 4.54vw, 20px);
    line-height: 28px;
    font-weight: 900;
  }
  .destination-trophy {
    font-size: 30px;
    line-height: 36px;
  }
  .roadmap-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    max-width: calc(100% - 32px);
    min-height: 52px;
    margin: 40px auto 0;
    padding: 12px 20px;
    border-radius: 12px;
    color: white;
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
  }
  @media (min-width: 1280px) {
    #learning-path {
      padding: 0 0 80px;
    }
    .roadmap-heading {
      height: 300px;
      padding-top: 68px;
    }
    .roadmap-heading h2 {
      font-size: 60px;
      line-height: 78px;
      margin-top: 9px;
    }
    .roadmap-heading p {
      font-size: 19px;
      line-height: 36.1px;
    }
    /* Figma 1280 / 1440 frames share this coordinate system. Growth is capped at 1440. */
    .roadmap-scene {
      --spread: clamp(0px, calc(75vw - 960px), 120px);
      display: block;
      width: calc(100% - 120px);
      max-width: none;
      height: calc(965px + var(--spread) * 0.6833333);
      margin: 0 auto;
    }
    .roadmap-card {
      position: absolute;
      width: 280px;
      min-height: 326px;
      max-width: none;
    }
    .beginner-card {
      inset-inline-start: 0;
      top: calc(228px + var(--spread) * 0.8833333);
      margin: 0;
    }
    .python-card {
      inset-inline-end: calc(279px + var(--spread) * 0.9166667);
      top: calc(61px + var(--spread) * 0.1416667);
    }
    .web-card {
      inset-inline-end: calc(279px + var(--spread) * 0.9166667);
      top: calc(475px + var(--spread) * 0.4416667);
    }
    .roadmap-choice {
      position: absolute;
      inset-inline-end: calc(640px + var(--spread));
      top: calc(289px + var(--spread) * 0.7916667);
      width: 200px;
      min-height: 240px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 18px 16px;
      text-align: center;
    }
    .roadmap-choice h3 {
      font-size: 20px;
      line-height: 28px;
      font-weight: 800;
    }
    .roadmap-choice p {
      font-size: 14px;
      line-height: 22px;
      margin-top: 13px;
    }
    .choice-icon {
      margin-bottom: 11px;
    }
    .roadmap-art {
      position: absolute;
      display: block;
      overflow: hidden;
      z-index: 0;
    }
    .python-art {
      inset-inline-end: 0;
      top: calc(115px + var(--spread) * 0.0583333);
      width: calc(600px + var(--spread) * 0.9083333);
      height: calc(320px + var(--spread) * 0.4666667);
    }
    .python-art img {
      position: absolute;
      width: 103.061%;
      height: 105.483%;
      left: -1.1905%;
      top: -1.3054%;
    }
    .web-art {
      inset-inline-end: 0;
      top: calc(548px + var(--spread) * 0.6833333);
      width: 100%;
      height: 417px;
      max-width: none;
      aspect-ratio: auto;
    }
    .web-art img {
      position: absolute;
      width: 109.272%;
      height: 112.532%;
      left: -4.3874%;
      top: -4.2278%;
    }
    .student-robot {
      display: block;
      position: absolute;
      top: calc(-155px - var(--spread) * 0.0166667);
      inset-inline-start: 12px;
      width: calc(283px + var(--spread) * 0.475);
      height: auto;
    }
    .python-robot {
      display: block;
      position: absolute;
      top: calc(29px + var(--spread) * 0.1);
      inset-inline-end: calc(44px + var(--spread) * 0.1333333);
      width: 80px;
      height: 110px;
      z-index: 1;
    }
    .web-robot {
      top: calc(691px + var(--spread) * 0.75);
      inset-inline-start: calc(261px + var(--spread) * 0.2583333);
      width: 80px;
      height: 110px;
      max-width: none;
    }
    .beginner-platform {
      display: none;
    }
    .destination-label {
      display: block;
      position: absolute;
      z-index: 1;
      font-size: 20px;
      line-height: 22px;
      font-weight: 700;
      text-align: center;
    }
    :global(html[dir="rtl"]) .destination-label {
      left: 12px;
      right: auto;
    }
    :global(html[dir="ltr"]) .destination-label {
      right: 12px;
      left: auto;
    }
    .python-label {
      top: calc(303px + var(--spread) * 0.3166667);
      color: #3b5bdb;
    }
    .web-label {
      top: calc(799px + var(--spread) * 0.6666667);
      color: #6d29e9;
    }
    .roadmap-destinations {
      flex-direction: row;
      justify-content: space-between;
      gap: 100px;
    }
    .roadmap-destinations::before {
      left: 10%;
      right: 10%;
      top: 50%;
      bottom: auto;
      border-left: 0;
      border-top: 2px dashed #b6a8f2;
    }
    .roadmap-cta {
      font-size: 20px;
      line-height: 20px;
      margin-top: 36px;
    }
  }
  @media (min-width: 1440px) {
    #learning-path {
      min-height: 1667px;
      padding-bottom: 100px;
    }
    .roadmap-heading {
      padding-top: 85px;
    }
    .roadmap-heading h2 {
      font-size: 68px;
      line-height: 78.2px;
    }
    .roadmap-card {
      height: 378px;
      padding: 20px 24px;
      border: 1px solid #eef2ff;
    }
    .web-card {
      height: 370px;
    }
    .beginner-card {
      height: 377px;
      border-color: #d1fae5;
    }
    .track-heading {
      flex-direction: column;
      gap: 0;
    }
    .track-titles {
      width: 100%;
      text-align: center;
    }
    .track-titles h3 {
      order: 0;
      font-size: 20px;
      line-height: 28px;
      font-weight: 900;
      margin-top: 4px;
    }
    .track-titles p {
      margin-top: 28px;
    }
    .track-icon {
      width: 64px;
      height: 64px;
    }
    .web-card .track-icon {
      width: 56px;
      height: 56px;
    }
    .roadmap-card ul {
      gap: 12px;
      margin: 24px 0 30px;
    }
    .track-number {
      min-width: 60px;
      height: 46px;
      font-size: 24px;
      line-height: 36px;
    }
    .track-age {
      position: absolute;
      bottom: 20px;
      inset-inline-start: 24px;
    }
    .roadmap-spark {
      display: block;
      position: absolute;
      inset-inline-start: 85px;
      top: 782px;
      width: 60px;
      height: 60px;
      opacity: 0.5;
      border-top: 1px dashed #635bff;
      transform: rotate(-45deg);
    }
  }
  @media (min-width: 1024px) and (max-width: 1279px) {
    .roadmap-heading h2 {
      font-size: 40px;
    }
    .roadmap-heading p {
      font-size: 16px;
    }
    .roadmap-scene {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 52px;
      margin-top: 72px;
    }
    .beginner-card {
      grid-column: 1/-1;
      justify-self: center;
      margin-inline-start: 119px;
    }
    .roadmap-choice {
      grid-column: 1/-1;
      justify-self: center;
      margin-inline-start: 52px;
    }
    .web-art {
      grid-column: 1/-1;
    }
    .python-card {
      grid-row: 4;
      grid-column: 1;
    }
    .web-card {
      grid-row: 4;
      grid-column: 2;
    }
    .web-robot {
      inset-inline-start: 124px;
    }
    .beginner-platform {
      inset-inline-start: 120px;
    }
  }
  .beginner-route {
    display: none;
  }
  /* Figma 344:1566: 281 x 326 cards, with the advanced tracks stacked through md. */
  @media (max-width: 1023px) {
    .roadmap-scene {
      width: calc(100% - 40px);
      max-width: 400px;
      gap: 0;
      margin-top: 38.5px;
    }
    .roadmap-card {
      padding: 32px 20px 20px;
      min-height: 326px;
    }
    .beginner-card {
      width: min(281px, calc(100% - 65px));
      margin: 0;
      justify-self: end;
    }
    .python-card,
    .web-card {
      justify-self: center;
      margin-top: 50px;
    }
    .track-icon {
      width: 64px;
      height: 64px;
    }
    .track-heading {
      gap: 16px;
    }
    .track-number {
      height: 40px;
      min-width: 52px;
    }
    .python-card .track-number,
    .web-card .track-number {
      left: -10px;
      right: auto;
    }
    .roadmap-card ul {
      position: relative;
      width: calc(100% - 29px);
      margin: 14px 0 16px auto;
      gap: 8px;
    }
    .roadmap-card ul::before {
      content: "";
      position: absolute;
      left: -26px;
      top: 16px;
      bottom: 16px;
      border-left: 1px dotted color-mix(in srgb, var(--accent) 45%, transparent);
    }
    .roadmap-card li {
      position: relative;
      min-height: 32px;
      padding: 4px 10px 4px 20px;
      border: 0.5px solid color-mix(in srgb, var(--accent) 10%, white);
      border-radius: 4px;
    }
    .roadmap-card li::before {
      content: "";
      position: absolute;
      width: 19px;
      left: -26px;
      top: 50%;
      border-top: 1px dotted color-mix(in srgb, var(--accent) 45%, transparent);
    }
    .roadmap-card li::after {
      content: "";
      position: absolute;
      left: -28px;
      top: calc(50% - 2px);
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--accent);
    }
    .roadmap-choice {
      margin-top: 28px;
      border-radius: 16px;
      gap: 20px;
      box-shadow: 0 8px 24px #4338ca12;
    }
    .python-art,
    .web-art {
      display: none;
    }
    .web-robot {
      top: 137px;
      inset-inline-start: 15px;
      width: 80px;
      height: 110px;
      max-width: none;
    }
    .beginner-platform {
      top: 201px;
      inset-inline-start: -0px;
      width: 119px;
      height: 87px;
      max-width: 30%;
    }
    .beginner-route {
      display: block;
      position: absolute;
      top: -4px;
      inset-inline-start: 47px;
      width: 47px;
      height: 231px;
      object-fit: fill;
    }
    .roadmap-destinations {
      max-width: 368px;
    }
  }
  @media (max-width: 399px) {
    .beginner-card {
      padding-inline: 12px;
    }
    .beginner-card .track-heading {
      gap: 8px;
    }
    .beginner-card .track-icon {
      width: 40px;
      height: 40px;
    }
    .beginner-card h3 {
