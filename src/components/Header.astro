---
import { Menu } from "@lucide/astro";
import { LOGIN_URL, SIGNUP_URL } from "@/constants";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)("header");
const links = [
  { href: "#home", label: t.home },
  { href: "#learning-path", label: t.learning },
  { href: "#academy", label: t.academy },
  { href: "#articles", label: t.articles },
  { href: "#pricing", label: t.pricing },
  { href: "#footer", label: t.contact },
];
---

<header
  class="site-header sticky top-0 z-50 bg-white font-header shadow-header"
>
  <div
    class="mx-auto flex h-[92px] w-[calc(100%-60px)] items-start justify-between min-[1200px]:w-[calc(100%-120px)]"
  >
    <a
      href={localizePath("/", lang)}
      class="mt-3 h-[68px] w-[78px] shrink-0 overflow-hidden"
      aria-label="Code Smart Academy"
    >
      <img
        class="size-full object-contain"
        src="/code-smart-academy-logo.png"
        alt="Code Smart Academy"
      />
    </a>

    <div class="mt-[26px] hidden items-start gap-8 min-[1180px]:flex">
      <nav
        class="flex items-start justify-center gap-8 text-lg leading-5 font-semibold text-navy"
        aria-label={t.menu}
      >
        {
          links.map((link, index) => (
            <a
              class="relative inline-flex min-h-[30px] items-start rounded-md px-0 transition-colors hover:text-[#594CE3] aria-[current=page]:text-[#594CE3] aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-[10px] aria-[current=page]:after:h-[1.5px] aria-[current=page]:after:rounded-full aria-[current=page]:after:bg-[#594CE3]"
              href={link.href}
              aria-current={index === 0 ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <a
        class="inline-flex h-10 min-w-[159px] items-center justify-center rounded-xl bg-brand-gradient px-5 text-base leading-5 font-bold text-white shadow-button transition-transform hover:-translate-y-0.5"
        href={SIGNUP_URL ?? "#future"}>{t.signup}</a
      >
    </div>

    <div class="mobile-header-actions">
      {
        LOGIN_URL ? (
          <a href={LOGIN_URL}>{t.login}</a>
        ) : (
          <button type="button" disabled aria-label={t.unavailable}>
            {t.login}
          </button>
        )
      }
      <a href={SIGNUP_URL ?? "#future"}>{t.signup}</a>
    </div>
    <div class="header-controls flex items-start gap-3">
      <button
        class="menu-toggle mt-5 inline-flex size-11 items-center justify-center rounded-xl border border-line text-brand min-[1180px]:hidden"
        type="button"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        aria-label={t.menu}
        data-open-label={t.menu}
        data-close-label={t.close}
      >
        <Menu size={22} aria-hidden="true" />
      </button>

      <a
        class="relative top-0 z-10 inline-flex h-[70px] w-[57px] items-center justify-center rounded-b-[20px] bg-green px-4 pt-2 text-xl leading-none font-bold text-white"
        data-language-switch
        href={localizePath(Astro.url.pathname, lang === "ar" ? "en" : "ar")}
        aria-label={t.languageLabel}
        lang={lang === "ar" ? "en" : "ar"}>{t.language}</a
      >
    </div>
  </div>

  <nav
    id="mobile-navigation"
    class="mx-auto grid w-[calc(100%-40px)] gap-1 border-t border-line bg-white py-3 text-[13px] min-[1180px]:hidden [&_a]:rounded-lg [&_a]:px-3 [&_a]:py-2.5 [&_a:hover]:bg-brand-soft [&_a:hover]:text-brand"
    aria-label={t.menu}
    hidden
  >
    {
      links.map((link, index) => (
        <a href={link.href} aria-current={index === 0 ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
    <a href={SIGNUP_URL ?? "#future"}>{t.signup}</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-navigation");

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute(
      "aria-label",
      (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? "",
    );
    menu.hidden = !open;
  }

  toggle?.addEventListener("click", () =>
    setOpen(toggle.getAttribute("aria-expanded") !== "true"),
  );
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      toggle?.getAttribute("aria-expanded") === "true"
    ) {
      setOpen(false);
      toggle.focus();
    }
  });
  window
    .matchMedia("(min-width: 1180px)")
    .addEventListener("change", () => setOpen(false));
  document
    .querySelectorAll<HTMLAnchorElement>("[data-language-switch]")
    .forEach((link) => {
      link.addEventListener("click", () => {
        const target = new URL(link.href);
        target.search = window.location.search;
        target.hash = window.location.hash;
        link.href = target.href;
      });
    });
</script>
