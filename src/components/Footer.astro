---
import { ArrowUp } from "@lucide/astro";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)("footer");
const sections = [
  {
    title: t.pointsTitle,
    links: t.pointsLinks.map((label) => ({ label, href: "#rewards" })),
  },
  {
    title: t.academyTitle,
    links: t.academyLinks.map((label, index) => ({
      label,
      href: index === 2 ? "#future" : "#academy",
    })),
  },
  {
    title: t.learningTitle,
    links: t.learningLinks.map((label) => ({ label, href: "#learning-path" })),
  },
];
const socials = ["f", "in", "tw", "yt"];
---

<footer id="footer" class="bg-[#1a3566] text-white">
  <div class="mx-auto w-[calc(100%-80px)] px-0 py-10 md:px-6 md:pt-16 md:pb-8">
    <div
      class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-[1.4fr_.64fr_.64fr_.64fr] md:gap-10"
    >
      <div class="md:max-w-[470px]">
        <a href={localizePath("/", lang)}
          ><img
            class="h-[68px] w-[78px] object-contain"
            src="/code-smart-academy-logo.png"
            alt="Code Smart Academy"
          /></a
        >
        <p class="mt-5 max-w-80 text-sm leading-[1.65] text-white/55">
          {t.description}
        </p>
        <div
          class="mt-5 flex gap-2.5 [direction:ltr] ltr:justify-start rtl:justify-end"
          aria-label={t.socialLabel}
        >
          {
            socials.map((social) => (
              <a
                class="inline-flex size-9 items-center justify-center rounded-xl bg-white/10 text-xs font-bold text-white/70 transition-colors hover:bg-white/15 hover:text-white"
                href="#footer"
                aria-label={social}
              >
                {social}
              </a>
            ))
          }
        </div>
      </div>
      {
        sections.map((section) => (
          <nav aria-label={section.title}>
            <h2 class="mb-4 text-sm font-bold text-white">{section.title}</h2>
            <ul class="grid list-none gap-3 p-0 text-sm text-white/55">
              {section.links.map((link) => (
                <li>
                  <a
                    class="transition-colors hover:text-white"
                    href={link.href}
                    dir={/^[A-Za-z]/.test(link.label) ? "ltr" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div
      class="relative mt-14 flex flex-col items-start gap-4 border-t border-white/10 pt-7 text-sm text-white/40 [direction:ltr] sm:flex-row sm:items-center sm:justify-between sm:gap-5"
    >
      <p class="flex gap-5" dir={lang === "ar" ? "rtl" : "ltr"}>
        <a class="hover:text-white" href="#footer">{t.termsLink}</a>
        <a class="hover:text-white" href="#footer">{t.privacyLink}</a>
      </p>
      <p dir={lang === "ar" ? "rtl" : "ltr"}>
        © 2026 Code Smart Academy. {t.rights}
      </p>
      <a
        href="#home"
        class="absolute end-0 top-5 flex size-9 items-center justify-center rounded-lg border border-white/20 text-white sm:static"
        aria-label={t.back}><ArrowUp size={18} aria-hidden="true" /></a
      >
    </div>
  </div>
</footer>
