---
import "@/styles/global.css";
import "@/styles/home-mobile.css";
import { useTranslations, localizePath } from "@/i18n/utils";
import type { Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
  dir: "rtl" | "ltr";
}
const { lang, dir } = Astro.props;
const t = useTranslations(lang)("layout");
const canonical = Astro.site
  ? new URL(localizePath("/", lang), Astro.site)
  : undefined;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#6b47dc" />
    <title>{t.title}</title>
    <link rel="icon" type="image/png" href="/code-smart-academy-logo.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      Astro.site && (
        <>
          <link
            rel="alternate"
            hreflang="ar"
            href={new URL("/ar/index.html", Astro.site)}
          />
          <link
            rel="alternate"
            hreflang="en"
            href={new URL("/en/index.html", Astro.site)}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL("/ar/index.html", Astro.site)}
          />
          <link rel="sitemap" href="/sitemap-index.xml" />
        </>
      )
    }
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arimo:wght@400;700&family=Cairo:wght@400;500;600;700;800;900&family=Noto+Sans+Arabic:wght@700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      class="fixed start-5 -top-24 z-[100] rounded-xl bg-ink px-5 py-3 text-white transition-[top] focus:top-5"
      href="#main-content">{t.skip}</a
    >
    <slot />
  </body>
</html>
