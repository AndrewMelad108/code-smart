---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import HeroSection from "@/components/home-components/HeroSection.astro";
import WhyCodeSmartSection from "@/components/home-components/WhyCodeSmartSection.astro";
import LearningPathSection from "@/components/home-components/LearningPathSection.astro";
import AgeGroupsSection from "@/components/home-components/AgeGroupsSection.astro";
import AcademySection from "@/components/home-components/AcademySection.astro";
import RewardsSection from "@/components/home-components/RewardsSection.astro";
import FutureSection from "@/components/home-components/FutureSection.astro";
import Footer from "@/components/Footer.astro";
---

<Layout lang="ar" dir="rtl">
  <Header />
  <main id="main-content">
    <HeroSection />
    <WhyCodeSmartSection />
    <LearningPathSection />
    <AgeGroupsSection />
    <span id="articles" class="block scroll-mt-24"></span>
    <AcademySection />
    <RewardsSection />
    <span id="pricing" class="block scroll-mt-24"></span>
    <FutureSection />
  </main>
  <Footer />
</Layout>
